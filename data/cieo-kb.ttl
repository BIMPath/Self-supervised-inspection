##############################################################################
# Inspection requirements
##############################################################################

kb:IR_P1_001 a insp:InspectionRequirement ;
    insp:requirementId "IR-P1-001" ;
    rdfs:label "IR-P1-001 Temporary traffic signs"@en ;
    insp:inspectionItemLabel "Temporary traffic signs" ;
    insp:requirementStatement "Roadwork signs and warning devices shall be placed according to the approved temporary signage scheme." ;
    insp:expectedCondition "ApprovedSignageSchemeRealised" ;
    insp:hasEvidencePattern insp:SpatialCompleteness ;
    insp:appliesToPhase kb:P1 ;
    insp:appliesToTargetType cst:TrafficManagementZone ;
    insp:specifiedBy kb:Clause_REG_CDS_285_1992_Art_21 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_stop_sign ;
    insp:requiresObjectClass kb:Class_traffic_barrier ;
    insp:requiredCoverage 0.95 ;
    rdfs:comment "Correct placement is a geometric relation between sign position and the approved scheme; detection alone proves presence, not conformity of layout. Second regulation: REG-DM-10-07-2002."@en .

kb:IR_P1_002 a insp:InspectionRequirement ;
    insp:requirementId "IR-P1-002" ;
    rdfs:label "IR-P1-002 Work-zone barriers"@en ;
    insp:inspectionItemLabel "Work-zone barriers" ;
    insp:requirementStatement "Work areas shall be delimited and pedestrians protected from the work zone." ;
    insp:expectedCondition "ContinuousDelimitationAlongWorkZoneBoundary" ;
    insp:hasEvidencePattern insp:SpatialCompleteness ;
    insp:appliesToPhase kb:P1 ;
    insp:appliesToTargetType cst:WorkZoneBoundary ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Allegato_XVIII_punto_1 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_barricade ;
    insp:requiresObjectClass kb:Class_fence ;
    insp:requiredCoverage 0.95 ;
    rdfs:comment "Continuity along the full boundary polyline is the requirement; single-frame detection is insufficient by construction."@en .

kb:IR_P1_003 a insp:InspectionRequirement ;
    insp:requirementId "IR-P1-003" ;
    rdfs:label "IR-P1-003 PPE usage"@en ;
    insp:inspectionItemLabel "PPE usage" ;
    insp:requirementStatement "Workers on site shall wear helmet, high-visibility vest and safety footwear." ;
    insp:expectedCondition "AllWorkersWearingRequiredPPE" ;
    insp:hasEvidencePattern insp:ComponentIntegrity ;
    insp:appliesToPhase kb:P1 ;
    insp:appliesToTargetType cst:Worker ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Titolo_III_Capo_II_Art_74_79 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_helmet ;
    insp:requiresObjectClass kb:Class_vest ;
    insp:requiresObjectClass kb:Class_boots ;
    rdfs:comment "Per-worker check. Head and feet are frequently occluded or below detector resolution at typical site standoff; the archetypal insufficient-evidence case."@en .

kb:IR_P2_004 a insp:InspectionRequirement ;
    insp:requirementId "IR-P2-004" ;
    rdfs:label "IR-P2-004 Excavation safety"@en ;
    insp:inspectionItemLabel "Excavation safety" ;
    insp:requirementStatement "Utility trenches shall be protected and access to them controlled." ;
    insp:expectedCondition "TrenchProtectedAndAccessControlled" ;
    insp:hasEvidencePattern insp:PresenceOfRequired ;
    insp:appliesToPhase kb:P2 ;
    insp:appliesToTargetType cst:UtilityTrench ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Art_118_Allegato_XVIII_punto_4 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_fence .

kb:IR_P2_005 a insp:InspectionRequirement ;
    insp:requirementId "IR-P2-005" ;
    rdfs:label "IR-P2-005 Hazard signage"@en ;
    insp:inspectionItemLabel "Hazard signage" ;
    insp:requirementStatement "Warning signs shall be posted and access to restricted areas prevented." ;
    insp:expectedCondition "HazardZoneSignedAndRestricted" ;
    insp:hasEvidencePattern insp:PresenceOfRequired ;
    insp:appliesToPhase kb:P2 ;
    insp:appliesToTargetType cst:HazardZone ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Titolo_V_Art_161_166 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_stop_sign ;
    insp:requiresObjectClass kb:Class_barricade ;
    rdfs:comment "Sign legibility rather than sign presence is the legal test; requires resolution beyond the current detector."@en .

kb:IR_P2_006 a insp:InspectionRequirement ;
    insp:requirementId "IR-P2-006" ;
    rdfs:label "IR-P2-006 Drilling equipment positioning"@en ;
    insp:inspectionItemLabel "Drilling equipment positioning" ;
    insp:requirementStatement "Drilling rigs shall be operated and stabilised safely." ;
    insp:expectedCondition "RigStableAndCorrectlyPositioned" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P2 ;
    insp:appliesToTargetType cst:DrillingRig ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Titolo_IV_Capo_I ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:VisualModality ;
    rdfs:comment "COVERAGE GAP: no drilling-rig class in the current 22-class detector vocabulary. Either extend the vocabulary or declare this requirement out of automatic scope."@en .

kb:IR_P3_007 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-007" ;
    rdfs:label "IR-P3-007 Excavation support systems"@en ;
    insp:inspectionItemLabel "Excavation support systems" ;
    insp:requirementStatement "Excavation faces and retaining systems shall be stable." ;
    insp:expectedCondition "FaceSlopeWithinAdmissibleAngleOrShored" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ExcavationFace ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Art_118_119 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:GeometricModality ;
    rdfs:comment "Verified from the registered point cloud (slope angle, shoring presence) rather than from RGB detection."@en .

kb:IR_P3_008 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-008" ;
    rdfs:label "IR-P3-008 Edge protection"@en ;
    insp:inspectionItemLabel "Edge protection" ;
    insp:requirementStatement "Fall-prevention barriers shall be provided around excavations." ;
    insp:expectedCondition "ContinuousEdgeProtectionAlongExcavationPerimeter" ;
    insp:hasEvidencePattern insp:SpatialCompleteness ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ExcavationBoundary ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Art_118_comma_3_Allegato_XVIII_punto_4 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_fence ;
    insp:requiresObjectClass kb:Class_barricade ;
    insp:requiredCoverage 0.95 ;
    rdfs:comment "FLAGSHIP CASE. Requires perimeter coverage, not a single positive detection."@en .

kb:IR_P3_009 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-009" ;
    rdfs:label "IR-P3-009 Reinforcement placement"@en ;
    insp:inspectionItemLabel "Reinforcement placement" ;
    insp:requirementStatement "Reinforcement shall be placed in accordance with the structural drawings and specifications." ;
    insp:expectedCondition "AsPlacedReinforcementMatchesDesign" ;
    insp:hasEvidencePattern insp:ComponentIntegrity ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ReinforcementAssembly ;
    insp:specifiedBy kb:Clause_REG_NTC_2018_Cap_4_1_EN_1992_1_1 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_steel_rebar ;
    insp:isHoldPointFor kb:Activity_AbutmentConcretePour ;
    rdfs:comment "HOLD POINT: irreversibly concealed by the pour. Bar count and spacing require fine GSD; second regulation REG-EN-1992."@en .

kb:IR_P3_010 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-010" ;
    rdfs:label "IR-P3-010 Formwork installation"@en ;
    insp:inspectionItemLabel "Formwork installation" ;
    insp:requirementStatement "Formwork shall be structurally stable and correctly assembled." ;
    insp:expectedCondition "FormworkStableAndCorrectlyAssembled" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:Formwork ;
    insp:specifiedBy kb:Clause_REG_NTC_2018_Cap_4_1_D_Lgs_81_2008_Art_122_126 ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:VisualModality ;
    insp:isHoldPointFor kb:Activity_AbutmentConcretePour ;
    rdfs:comment "COVERAGE GAP: no formwork class in the detector vocabulary."@en .

kb:IR_P3_011 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-011" ;
    rdfs:label "IR-P3-011 Concrete quality control"@en ;
    insp:inspectionItemLabel "Concrete quality control" ;
    insp:requirementStatement "Concrete shall be certified and placed according to the prescribed execution procedures." ;
    insp:expectedCondition "ValidConformityCertificateOnFile" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ConcreteBatch ;
    insp:specifiedBy kb:Clause_REG_UNI_7163_72_Conformity_control ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_ConcreteBatchPlacement ;
    rdfs:comment "Document-backed; enters the graph as DocumentEvidence, not as an observation. Second regulation REG-UNI-7122-72."@en .

kb:IR_P3_012 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-012" ;
    rdfs:label "IR-P3-012 Concrete quality control"@en ;
    insp:inspectionItemLabel "Concrete quality control" ;
    insp:requirementStatement "Aggregate size in the concrete mix shall conform to the specified grading." ;
    insp:expectedCondition "AggregateGradingConforms" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ConcreteBatch ;
    insp:specifiedBy kb:Clause_REG_UNI_7466_75_Parts_1_3 ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality .

kb:IR_P3_013 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-013" ;
    rdfs:label "IR-P3-013 Concrete curing"@en ;
    insp:inspectionItemLabel "Concrete curing" ;
    insp:requirementStatement "Curing shall be carried out and formwork struck according to the prescribed procedure." ;
    insp:expectedCondition "CuringProcedureFollowed" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ConcreteElement ;
    insp:specifiedBy kb:Clause_REG_UNI_9558_Curing_and_striking ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    rdfs:comment "Temporal requirement: verified over an interval, not at an instant."@en .

kb:IR_P3_014 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-014" ;
    rdfs:label "IR-P3-014 Concrete testing"@en ;
    insp:inspectionItemLabel "Concrete testing" ;
    insp:requirementStatement "Fresh concrete samples shall be collected as prescribed." ;
    insp:expectedCondition "SamplesCollectedPerLot" ;
    insp:hasEvidencePattern insp:MaterialTestConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ConcreteBatch ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_12350_1_Sampling ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:MaterialTestModality ;
    insp:isHoldPointFor kb:Activity_ConcreteBatchPlacement .

kb:IR_P3_015 a insp:InspectionRequirement ;
    insp:requirementId "IR-P3-015" ;
    rdfs:label "IR-P3-015 Concrete cover"@en ;
    insp:inspectionItemLabel "Concrete cover" ;
    insp:requirementStatement "Concrete cover to reinforcement shall comply with the prescribed minimum." ;
    insp:expectedCondition "CoverAtOrAboveMinimum" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P3 ;
    insp:appliesToTargetType cst:ReinforcementAssembly ;
    insp:specifiedBy kb:Clause_REG_DM_09_01_1996_Cover_and_prestressing_provisions ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:GeometricModality ;
    insp:requiresObjectClass kb:Class_steel_rebar ;
    insp:isHoldPointFor kb:Activity_AbutmentConcretePour ;
    rdfs:comment "HOLD POINT. Measurable pre-pour from registered point cloud plus rebar detection; not measurable post-pour without a covermeter."@en .

kb:IR_P4_016 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-016" ;
    rdfs:label "IR-P4-016 Demolition exclusion zones"@en ;
    insp:inspectionItemLabel "Demolition exclusion zones" ;
    insp:requirementStatement "Access to the demolition zone shall be controlled and workers protected." ;
    insp:expectedCondition "ZoneBarrieredAndClearOfPersonnel" ;
    insp:hasEvidencePattern insp:VerifiedAbsence ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:DemolitionExclusionZone ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Art_151_156 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_fence ;
    insp:requiresObjectClass kb:Class_barricade ;
    insp:prohibitsObjectClass kb:Class_helmet ;
    insp:prohibitsObjectClass kb:Class_vest ;
    insp:prohibitsObjectClass kb:Class_boots ;
    rdfs:comment "Compound requirement: presence of the barrier AND verified absence of workers inside the zone. The absence half cannot be settled by detection alone."@en .

kb:IR_P4_017 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-017" ;
    rdfs:label "IR-P4-017 Steel structural elements"@en ;
    insp:inspectionItemLabel "Steel structural elements" ;
    insp:requirementStatement "Structural steel components shall be produced under a conformity assessment system." ;
    insp:expectedCondition "FactoryProductionControlCertificateOnFile" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:SteelComponentLot ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_1090_1_Conformity_assessment ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_SteelErection ;
    rdfs:comment "Off-site; CE marking and FPC certificate."@en .

kb:IR_P4_018 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-018" ;
    rdfs:label "IR-P4-018 Steel elements production"@en ;
    insp:inspectionItemLabel "Steel elements production" ;
    insp:requirementStatement "Welding processes shall conform to the specified process nomenclature and qualification." ;
    insp:expectedCondition "WeldingProcedureQualified" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:WeldedJoint ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_ISO_4063_Process_nomenclature ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_SteelErection ;
    rdfs:comment "Weld quality is verified by NDT records, not by RGB imagery."@en .

kb:IR_P4_019 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-019" ;
    rdfs:label "IR-P4-019 Structural connecting elements"@en ;
    insp:inspectionItemLabel "Structural connecting elements" ;
    insp:requirementStatement "Bolting assemblies shall be complete and correctly installed with the specified inspection documentation." ;
    insp:expectedCondition "BoltNutWasherPresentAndTightened" ;
    insp:hasEvidencePattern insp:ComponentIntegrity ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:BoltedConnection ;
    insp:specifiedBy kb:Clause_REG_EN_ISO_16228_Inspection_documents ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_bolt ;
    insp:requiresObjectClass kb:Class_nut ;
    insp:requiresObjectClass kb:Class_washer ;
    insp:prohibitsObjectClass kb:Class_loose_bolt ;
    insp:prohibitsObjectClass kb:Class_missing_bolt ;
    rdfs:comment "FLAGSHIP CASE. A washer hidden behind the nut is geometrically unobservable from most viewpoints: the canonical insufficient-evidence instance. Second regulation REG-NTC-2018 Cap. 4.2.8."@en .

kb:IR_P4_020 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-020" ;
    rdfs:label "IR-P4-020 Steel structural elements"@en ;
    insp:inspectionItemLabel "Steel structural elements" ;
    insp:requirementStatement "Hot-rolled structural steel products shall conform to the specified product standards." ;
    insp:expectedCondition "MillCertificatesConform" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:SteelComponentLot ;
    insp:specifiedBy kb:Clause_REG_EN_10025_EN_10025_1_to_6_and_related ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_SteelErection .

kb:IR_P4_021 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-021" ;
    rdfs:label "IR-P4-021 Steel structural elements"@en ;
    insp:inspectionItemLabel "Steel structural elements" ;
    insp:requirementStatement "Cold-formed structural steel products shall conform to the specified product standards." ;
    insp:expectedCondition "MillCertificatesConform" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:SteelComponentLot ;
    insp:specifiedBy kb:Clause_REG_EN_10025_2_EN_10025_2_and_related ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_SteelErection .

kb:IR_P4_022 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-022" ;
    rdfs:label "IR-P4-022 Debris containment"@en ;
    insp:inspectionItemLabel "Debris containment" ;
    insp:requirementStatement "Falling material shall be contained and prevented from reaching persons or property." ;
    insp:expectedCondition "DebrisContainmentInPlace" ;
    insp:hasEvidencePattern insp:PresenceOfRequired ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:DemolitionZone ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Art_153_154 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_fence ;
    insp:requiresObjectClass kb:Class_barricade ;
    rdfs:comment "Chutes and containment sheeting are not in the detector vocabulary; only the perimeter half is automatable."@en .

kb:IR_P4_023 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-023" ;
    rdfs:label "IR-P4-023 Elastomeric bearing disc"@en ;
    insp:inspectionItemLabel "Elastomeric bearing disc" ;
    insp:requirementStatement "Structural bearings shall be of the specified type and correctly installed to provide the design constraint." ;
    insp:expectedCondition "BearingTypeAndSeatingAsDesigned" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:BearingAssembly ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_1337_Structural_bearings ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:VisualModality ;
    insp:isHoldPointFor kb:Activity_SteelErection ;
    rdfs:comment "COVERAGE GAP: no bearing class in the detector vocabulary."@en .

kb:IR_P4_024 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-024" ;
    rdfs:label "IR-P4-024 Structural member installation"@en ;
    insp:inspectionItemLabel "Structural member installation" ;
    insp:requirementStatement "Structural members shall be installed in the sequence and configuration required by the design." ;
    insp:expectedCondition "AllDesignMembersPresentAtStage" ;
    insp:hasEvidencePattern insp:VerifiedAbsence ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:SteelMember ;
    insp:specifiedBy kb:Clause_REG_NTC_2018_Cap_4_2_Cap_5_1 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_beams ;
    insp:requiresObjectClass kb:Class_column ;
    rdfs:comment "BIM-conditioned presence check: the expected member set comes from the model, so a missing member is a verified absence problem. Second regulation REG-EN-1993."@en .

kb:IR_P4_025 a insp:InspectionRequirement ;
    insp:requirementId "IR-P4-025" ;
    rdfs:label "IR-P4-025 Lifting operations"@en ;
    insp:inspectionItemLabel "Lifting operations" ;
    insp:requirementStatement "Lifting operations shall be planned and carried out safely." ;
    insp:expectedCondition "LiftPlanFollowedAndZoneClear" ;
    insp:hasEvidencePattern insp:VerifiedAbsence ;
    insp:appliesToPhase kb:P4 ;
    insp:appliesToTargetType cst:LiftingZone ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Titolo_IV_Capo_I_Allegato_VI ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:VisualModality ;
    insp:prohibitsObjectClass kb:Class_helmet ;
    insp:prohibitsObjectClass kb:Class_vest ;
    insp:prohibitsObjectClass kb:Class_boots ;
    rdfs:comment "COVERAGE GAP: no crane or load class in the detector vocabulary."@en .

kb:IR_P5_026 a insp:InspectionRequirement ;
    insp:requirementId "IR-P5-026" ;
    rdfs:label "IR-P5-026 Reinforcement and formwork inspection"@en ;
    insp:inspectionItemLabel "Reinforcement and formwork inspection" ;
    insp:requirementStatement "Reinforcement and formwork shall be verified before concrete placement." ;
    insp:expectedCondition "VerifiedBeforePour" ;
    insp:hasEvidencePattern insp:ComponentIntegrity ;
    insp:appliesToPhase kb:P5 ;
    insp:appliesToTargetType cst:DeckSlab ;
    insp:specifiedBy kb:Clause_REG_NTC_2018_Cap_4_1_6 ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_steel_rebar ;
    insp:requiresObjectClass kb:Class_steel_stud ;
    insp:isHoldPointFor kb:Activity_DeckSlabConcretePour ;
    rdfs:comment "HOLD POINT with an explicit temporal ordering constraint: the observation must precede the pour activity, which the phase model can enforce."@en .

kb:IR_P5_027 a insp:InspectionRequirement ;
    insp:requirementId "IR-P5-027" ;
    rdfs:label "IR-P5-027 Expansion joint"@en ;
    insp:inspectionItemLabel "Expansion joint" ;
    insp:requirementStatement "The expansion joint shall prevent water ingress through the deck gap." ;
    insp:expectedCondition "JointInstalledAndSealed" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P5 ;
    insp:appliesToTargetType cst:ExpansionJoint ;
    insp:specifiedBy kb:Clause_REG_ETAG_032_ETA_approval ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:VisualModality ;
    rdfs:comment "COVERAGE GAP: no expansion-joint class in the detector vocabulary."@en .

kb:IR_P5_028 a insp:InspectionRequirement ;
    insp:requirementId "IR-P5-028" ;
    rdfs:label "IR-P5-028 Utility protection measures"@en ;
    insp:inspectionItemLabel "Utility protection measures" ;
    insp:requirementStatement "Utilities shall be protected and reinstated in accordance with the approved relocation plans." ;
    insp:expectedCondition "ReinstatementMatchesApprovedPlan" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P5 ;
    insp:appliesToTargetType cst:UtilityRun ;
    insp:specifiedBy kb:Clause_REG_PROJ_SPEC_Approved_relocation_plans ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_UtilityBackfill ;
    rdfs:comment "Concealed after backfill; as-built survey is the only durable evidence. Second regulation REG-DLGS-81-2008."@en .

kb:IR_P6_029 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-029" ;
    rdfs:label "IR-P6-029 Pavement geometry and surface condition"@en ;
    insp:inspectionItemLabel "Pavement geometry and surface condition" ;
    insp:requirementStatement "Pavement geometry and surface condition shall comply with the roadway design." ;
    insp:expectedCondition "GeometryWithinDesignTolerance" ;
    insp:hasEvidencePattern insp:GeometricConformance ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:PavementSurface ;
    insp:specifiedBy kb:Clause_REG_NTC_2018_Cap_5_1 ;
    insp:hasCheckability insp:Assisted ;
    insp:requiresModality insp:GeometricModality ;
    rdfs:comment "Verified from the registered point cloud against the design surface, including the 32 cm raised profile and the 5% / 3.5% ramp slopes."@en .

kb:IR_P6_030 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-030" ;
    rdfs:label "IR-P6-030 Deck waterproofing"@en ;
    insp:inspectionItemLabel "Deck waterproofing" ;
    insp:requirementStatement "Concrete surfaces subject to traffic shall be waterproofed with a reinforced bituminous sheath." ;
    insp:expectedCondition "WaterproofingLayerInstalledBeforeSurfacing" ;
    insp:hasEvidencePattern insp:DocumentaryConformance ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:DeckSlab ;
    insp:specifiedBy kb:Clause_REG_EN_14695_2010_Reinforced_bitumen_sheets ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:DocumentaryModality ;
    insp:isHoldPointFor kb:Activity_WearingCourseLaying ;
    rdfs:comment "HOLD POINT: concealed by the wearing course. Photographic evidence must be timestamped before surfacing."@en .

kb:IR_P6_031 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-031" ;
    rdfs:label "IR-P6-031 Road paving material"@en ;
    insp:inspectionItemLabel "Road paving material" ;
    insp:requirementStatement "The bitumen binder shall meet the specified characteristics." ;
    insp:expectedCondition "BinderCharacteristicsConform" ;
    insp:hasEvidencePattern insp:MaterialTestConformance ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:PavementMaterial ;
    insp:specifiedBy kb:Clause_REG_ANAS_CSA_Binder_characteristics ;
    insp:hasCheckability insp:Manual ;
    insp:requiresModality insp:MaterialTestModality .

kb:IR_P6_032 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-032" ;
    rdfs:label "IR-P6-032 Presence and continuity of barriers"@en ;
    insp:inspectionItemLabel "Presence and continuity of barriers" ;
    insp:requirementStatement "Roadside safety barriers shall be installed with the required class and without discontinuity." ;
    insp:expectedCondition "ContinuousRestraintSystemAlongAlignment" ;
    insp:hasEvidencePattern insp:SpatialCompleteness ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:RoadRestraintSystem ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_1317_Road_restraint_systems ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_traffic_barrier ;
    insp:requiredCoverage 0.95 ;
    rdfs:comment "FLAGSHIP CASE. Continuity is a coverage predicate over the whole alignment: the requirement is unsatisfiable from evidence unless observed coverage approaches 1."@en .

kb:IR_P6_033 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-033" ;
    rdfs:label "IR-P6-033 Pedestrian protection systems"@en ;
    insp:inspectionItemLabel "Pedestrian protection systems" ;
    insp:requirementStatement "Handrails and pedestrian safety barriers shall be installed." ;
    insp:expectedCondition "ParapetInstalledAlongPedestrianRoute" ;
    insp:hasEvidencePattern insp:SpatialCompleteness ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:PedestrianParapet ;
    insp:specifiedBy kb:Clause_REG_UNI_EN_1317_Road_restraint_systems ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:requiresObjectClass kb:Class_barrier ;
    insp:requiresObjectClass kb:Class_fence ;
    insp:requiredCoverage 0.95 ;
    rdfs:comment "Second regulation REG-DLGS-81-2008."@en .

kb:IR_P6_034 a insp:InspectionRequirement ;
    insp:requirementId "IR-P6-034" ;
    rdfs:label "IR-P6-034 Site restoration and removal of temporary works"@en ;
    insp:inspectionItemLabel "Site restoration and removal of temporary works" ;
    insp:requirementStatement "All temporary structures and barriers shall be removed and the site restored." ;
    insp:expectedCondition "NoTemporaryWorksRemaining" ;
    insp:hasEvidencePattern insp:VerifiedAbsence ;
    insp:appliesToPhase kb:P6 ;
    insp:appliesToTargetType cst:SiteArea ;
    insp:specifiedBy kb:Clause_REG_DLGS_81_2008_Titolo_IV_Capo_I ;
    insp:hasCheckability insp:Automatic ;
    insp:requiresModality insp:VisualModality ;
    insp:prohibitsObjectClass kb:Class_barricade ;
    insp:prohibitsObjectClass kb:Class_container ;
    insp:prohibitsObjectClass kb:Class_fence ;
    insp:prohibitsObjectClass kb:Class_traffic_barrier ;
    rdfs:comment "FLAGSHIP CASE. A purely negative requirement: satisfied only by verified absence over the whole site, which is the hardest thing for an open-world detector to establish."@en .
