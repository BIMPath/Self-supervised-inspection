##############################################################################
# Detector object classes, with the physical parameters that decide observability
##############################################################################

kb:Class_beams a obs:ObjectClass ;
    skos:prefLabel "SteelMember"@en ;
    obs:detectorLabel "beams" ;
    obs:charDimInstalled 0.8000 ;
    obs:minPixelsOnTarget 24 ;
    obs:occlusionSensitivity 0.35 ;
    obs:selfOcclusionPrior 0.05 ;
    obs:baseRecallRef 0.90 ;
    rdfs:comment "HEB800 web depth. Large, high-contrast against sky; robust at long standoff."@en .

kb:Class_column a obs:ObjectClass ;
    skos:prefLabel "SteelMember"@en ;
    obs:detectorLabel "column" ;
    obs:charDimInstalled 0.4000 ;
    obs:minPixelsOnTarget 24 ;
    obs:occlusionSensitivity 0.40 ;
    obs:selfOcclusionPrior 0.10 ;
    obs:baseRecallRef 0.87 .

kb:Class_steel_rebar a obs:ObjectClass ;
    skos:prefLabel "ReinforcingBar"@en ;
    obs:detectorLabel "steel rebar" ;
    obs:charDimInstalled 0.0200 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.70 ;
    obs:selfOcclusionPrior 0.45 ;
    obs:baseRecallRef 0.62 ;
    rdfs:comment "Bar diameter B450C. Dense cages self-occlude heavily; individual bar counting is far harder than cage presence."@en .

kb:Class_steel_stud a obs:ObjectClass ;
    skos:prefLabel "ShearStud"@en ;
    obs:detectorLabel "steel stud" ;
    obs:charDimInstalled 0.0190 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.65 ;
    obs:selfOcclusionPrior 0.30 ;
    obs:baseRecallRef 0.58 ;
    rdfs:comment "Nelson stud shank diameter."@en .

kb:Class_concrete a obs:ObjectClass ;
    skos:prefLabel "ConcreteSurface"@en ;
    obs:detectorLabel "concrete" ;
    obs:charDimInstalled 1.0000 ;
    obs:minPixelsOnTarget 24 ;
    obs:occlusionSensitivity 0.20 ;
    obs:selfOcclusionPrior 0.02 ;
    obs:baseRecallRef 0.92 ;
    rdfs:comment "Surface class, not an object; presence is near-trivial, condition is not."@en .

kb:Class_bolt a obs:ObjectClass ;
    skos:prefLabel "Fastener"@en ;
    obs:detectorLabel "bolt" ;
    obs:charDimInstalled 0.0240 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.75 ;
    obs:selfOcclusionPrior 0.35 ;
    obs:baseRecallRef 0.66 ;
    rdfs:comment "M24 shank. Only the protruding end is visible once installed."@en .

kb:Class_nut a obs:ObjectClass ;
    skos:prefLabel "Fastener"@en ;
    obs:detectorLabel "nut" ;
    obs:charDimInstalled 0.0360 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.75 ;
    obs:selfOcclusionPrior 0.30 ;
    obs:baseRecallRef 0.68 ;
    rdfs:comment "M24 nut across flats."@en .

kb:Class_washer a obs:ObjectClass ;
    skos:prefLabel "Fastener"@en ;
    obs:detectorLabel "washer" ;
    obs:charDimInstalled 0.0040 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.90 ;
    obs:selfOcclusionPrior 0.80 ;
    obs:baseRecallRef 0.41 ;
    rdfs:comment "CRITICAL: once the nut is torqued, only the 4 mm washer edge annulus is visible, and only from a near-tangential viewpoint. The highest self-occlusion prior in the vocabulary and the reason IR-P4-019 is the canonical insufficient-evidence case."@en .

kb:Class_loose_bolt a obs:ObjectClass ;
    skos:prefLabel "FastenerDefect"@en ;
    obs:detectorLabel "loose bolt" ;
    obs:charDimInstalled 0.0080 ;
    obs:minPixelsOnTarget 40 ;
    obs:occlusionSensitivity 0.85 ;
    obs:selfOcclusionPrior 0.60 ;
    obs:baseRecallRef 0.34 ;
    rdfs:comment "Defect class: requires resolving thread protrusion differential, i.e. a sub-feature of the bolt itself."@en .

kb:Class_missing_bolt a obs:ObjectClass ;
    skos:prefLabel "FastenerDefect"@en ;
    obs:detectorLabel "missing bolt" ;
    obs:charDimInstalled 0.0260 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.70 ;
    obs:selfOcclusionPrior 0.40 ;
    obs:baseRecallRef 0.45 ;
    rdfs:comment "Defect class defined by an empty hole; strongly confusable with an occluded bolt."@en .

kb:Class_container a obs:ObjectClass ;
    skos:prefLabel "SiteFacility"@en ;
    obs:detectorLabel "container" ;
    obs:charDimInstalled 2.4000 ;
    obs:minPixelsOnTarget 16 ;
    obs:occlusionSensitivity 0.20 ;
    obs:selfOcclusionPrior 0.02 ;
    obs:baseRecallRef 0.94 .

kb:Class_barricade a obs:ObjectClass ;
    skos:prefLabel "TemporaryProtection"@en ;
    obs:detectorLabel "barricade" ;
    obs:charDimInstalled 1.0000 ;
    obs:minPixelsOnTarget 20 ;
    obs:occlusionSensitivity 0.35 ;
    obs:selfOcclusionPrior 0.10 ;
    obs:baseRecallRef 0.86 .

kb:Class_barrier a obs:ObjectClass ;
    skos:prefLabel "TemporaryProtection"@en ;
    obs:detectorLabel "barrier" ;
    obs:charDimInstalled 1.0000 ;
    obs:minPixelsOnTarget 20 ;
    obs:occlusionSensitivity 0.35 ;
    obs:selfOcclusionPrior 0.10 ;
    obs:baseRecallRef 0.88 ;
    rdfs:comment "Primary evidence class for edge protection (IR-P3-008) and work-zone delimitation (IR-P1-002)."@en .

kb:Class_traffic_barrier a obs:ObjectClass ;
    skos:prefLabel "TemporaryProtection"@en ;
    obs:detectorLabel "traffic barrier" ;
    obs:charDimInstalled 0.8000 ;
    obs:minPixelsOnTarget 20 ;
    obs:occlusionSensitivity 0.30 ;
    obs:selfOcclusionPrior 0.08 ;
    obs:baseRecallRef 0.87 ;
    rdfs:comment "New Jersey type; also evidence for IR-P6-032."@en .

kb:Class_stop_sign a obs:ObjectClass ;
    skos:prefLabel "Signage"@en ;
    obs:detectorLabel "stop sign" ;
    obs:charDimInstalled 0.6000 ;
    obs:minPixelsOnTarget 24 ;
    obs:occlusionSensitivity 0.30 ;
    obs:selfOcclusionPrior 0.05 ;
    obs:baseRecallRef 0.85 ;
    rdfs:comment "Presence is detectable; legibility of the sign face is not, which is what the regulation actually requires."@en .

kb:Class_gloves a obs:ObjectClass ;
    skos:prefLabel "PPE"@en ;
    obs:detectorLabel "gloves" ;
    obs:charDimInstalled 0.2500 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.80 ;
    obs:selfOcclusionPrior 0.55 ;
    obs:baseRecallRef 0.49 ;
    rdfs:comment "Hands are occluded by the task being performed more often than not."@en .

kb:Class_helmet a obs:ObjectClass ;
    skos:prefLabel "PPE"@en ;
    obs:detectorLabel "helmet" ;
    obs:charDimInstalled 0.2800 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.55 ;
    obs:selfOcclusionPrior 0.15 ;
    obs:baseRecallRef 0.78 ;
    rdfs:comment "Most reliable PPE class: high on the body, high contrast, rarely self-occluded."@en .

kb:Class_boots a obs:ObjectClass ;
    skos:prefLabel "PPE"@en ;
    obs:detectorLabel "boots" ;
    obs:charDimInstalled 0.3000 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.85 ;
    obs:selfOcclusionPrior 0.65 ;
    obs:baseRecallRef 0.38 ;
    rdfs:comment "Feet are occluded by terrain, spoil heaps, formwork and other workers in most site imagery."@en .

kb:Class_vest a obs:ObjectClass ;
    skos:prefLabel "PPE"@en ;
    obs:detectorLabel "vest" ;
    obs:charDimInstalled 0.6000 ;
    obs:minPixelsOnTarget 24 ;
    obs:occlusionSensitivity 0.45 ;
    obs:selfOcclusionPrior 0.10 ;
    obs:baseRecallRef 0.83 ;
    rdfs:comment "Retroreflective, large; the most reliable PPE evidence after helmet."@en .

kb:Class_fence a obs:ObjectClass ;
    skos:prefLabel "TemporaryProtection"@en ;
    obs:detectorLabel "fence" ;
    obs:charDimInstalled 2.0000 ;
    obs:minPixelsOnTarget 20 ;
    obs:occlusionSensitivity 0.40 ;
    obs:selfOcclusionPrior 0.10 ;
    obs:baseRecallRef 0.84 ;
    rdfs:comment "Mesh fencing; low texture contrast against background is the main failure mode, not size."@en .

kb:Class_nuts a obs:ObjectClass ;
    skos:prefLabel "Fastener"@en ;
    obs:detectorLabel "nuts" ;
    obs:charDimInstalled 0.0360 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.75 ;
    obs:selfOcclusionPrior 0.30 ;
    obs:baseRecallRef 0.68 ;
    rdfs:comment "Plural duplicate of OC-07 in the trained vocabulary; merge before use and report the merge."@en .

kb:Class_bolt_dup a obs:ObjectClass ;
    skos:prefLabel "Fastener"@en ;
    obs:detectorLabel "bolt_dup" ;
    obs:charDimInstalled 0.0240 ;
    obs:minPixelsOnTarget 32 ;
    obs:occlusionSensitivity 0.75 ;
    obs:selfOcclusionPrior 0.35 ;
    obs:baseRecallRef 0.66 ;
    rdfs:comment "Duplicate of OC-06 in the trained vocabulary; merge before use and report the merge."@en .

kb:Class_nuts obs:mergedInto kb:Class_nut .
kb:Class_bolt_dup obs:mergedInto kb:Class_bolt .


##############################################################################
# Concealing activities (hold-point closures)
##############################################################################

kb:Activity_AbutmentConcretePour a cst:ConcealingActivity ;
    rdfs:label "Abutment concrete pour"@en ;
    cst:belongsToPhase kb:P3 .

kb:Activity_DeckSlabConcretePour a cst:ConcealingActivity ;
    rdfs:label "Deck slab concrete pour"@en ;
    cst:belongsToPhase kb:P5 .

kb:Activity_UtilityBackfill a cst:ConcealingActivity ;
    rdfs:label "Utility trench backfill"@en ;
    cst:belongsToPhase kb:P5 .

kb:Activity_WearingCourseLaying a cst:ConcealingActivity ;
    rdfs:label "Wearing course laying"@en ;
    cst:belongsToPhase kb:P6 .

kb:Activity_SteelErection a cst:ConcealingActivity ;
    rdfs:label "Steel superstructure erection"@en ;
    cst:belongsToPhase kb:P4 .

kb:Activity_ConcreteBatchPlacement a cst:ConcealingActivity ;
    rdfs:label "Concrete batch placement"@en ;
    cst:belongsToPhase kb:P3 .


