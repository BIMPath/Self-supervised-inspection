<https://w3id.org/cieo/kb>
    a owl:Ontology ;
    dcterms:title "CIEO knowledge base — Savigliano bridge inspection requirements"@en ;
    dcterms:description """Generated from the CSVs under data/ by src/csv_to_rdf.py.

DO NOT EDIT BY HAND. The CSVs are authoritative; edit those and regenerate. Hand-editing
this file is how the checklist a domain expert reviews and the graph the reasoner runs on
stop being the same thing."""@en ;
    dcterms:created "2026-09-10"^^xsd:date ;
    owl:imports <https://w3id.org/cieo> .


##############################################################################
# Construction phases
##############################################################################

kb:P1 a cst:ConstructionPhase ;
    rdfs:label "Site preparation and temporary traffic management"@en ;
    rdfs:comment "Dismantling of the existing pedestrian passage, installation of the temporary Bailey bridge, work-zone delimitation and temporary traffic management."@en ;
    cst:phaseSequence 1 ;
    cst:phasePrecedes kb:P2 .

kb:P2 a cst:ConstructionPhase ;
    rdfs:label "Utility relocation and micropile construction"@en ;
    rdfs:comment "Temporary relocation of underground utilities and construction of abutment micropiles worked from the existing road surface under alternating one-way traffic."@en ;
    cst:phaseSequence 2 ;
    cst:phasePrecedes kb:P3 .

kb:P3 a cst:ConstructionPhase ;
    rdfs:label "Excavation and abutment construction"@en ;
    rdfs:comment "Excavation for the new abutments and execution of the reinforced-concrete abutment works, including the set-back of the left abutment."@en ;
    cst:phaseSequence 3 ;
    cst:phasePrecedes kb:P4 .

kb:P4 a cst:ConstructionPhase ;
    rdfs:label "Existing bridge demolition and steel superstructure installation"@en ;
    rdfs:comment "Demolition of the existing arch deck and abutments, followed by erection of the corten steel braced deck and its bolted connections and bearings."@en ;
    cst:phaseSequence 4 ;
    cst:phasePrecedes kb:P5 .

kb:P5 a cst:ConstructionPhase ;
    rdfs:label "Deck slab construction and utility reinstatement"@en ;
    rdfs:comment "Construction of the predalles connecting slab with shear studs, completion of abutment works, expansion joints and permanent utility reinstatement."@en ;
    cst:phaseSequence 5 ;
    cst:phasePrecedes kb:P6 .

kb:P6 a cst:ConstructionPhase ;
    rdfs:label "Road finishing, guardrail installation and completion"@en ;
    rdfs:comment "Waterproofing and pavement works on the raised road surface, roadside restraint system installation, site restoration and removal of all temporary works."@en ;
    cst:phaseSequence 6 .


